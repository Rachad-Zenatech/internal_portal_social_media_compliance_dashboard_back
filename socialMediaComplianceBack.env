# ==============================================================================
# Social Media Compliance Dashboard Backend Configuration
# ==============================================================================

# Server & Network Ports
PORT=8009
HOST=0.0.0.0
MCP_PORT=7006

# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:3008/social_media_compliance_dev
DATABASE_SSL=false
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=5
DB_POOL_MAX_QUERIES=50000
DB_POOL_MAX_INACTIVE_LIFETIME=300.0
DB_COMMAND_TIMEOUT=120.0

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5179
CORS_ALLOWED_ORIGINS="http://localhost:5179,http://127.0.0.1:5179"

# Microsoft Entra ID Authentication
MICROSOFT_CLIENT_ID=your-microsoft-client-id-here
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-here
MICROSOFT_TENANT_ID=your-microsoft-tenant-id-here
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/your-microsoft-tenant-id-here
MICROSOFT_REDIRECT_URI=http://localhost:8009/api/auth/microsoft/callback

# Session & Token Security
SESSION_SECRET=social-media-session-secret-32-characters-key
SESSION_COOKIE_SECURE=false
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_TTL_SECONDS=7200

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS_PER_WINDOW=1200

# Development & Watcher Configuration
WATCHFILES_FORCE_POLLING=true

# MQTT Event-Driven Microservice Presence & Messaging Bus
SERVICE_NAME=social-media
SERVICE_INSTANCE_ID=social-media-01
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USE_TLS=false
MQTT_KEEPALIVE_SECONDS=15

# RabbitMQ Asynchronous Cross-Service Messaging Configuration
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
COMMANDS_EXCHANGE=ceo.commands
EVENTS_EXCHANGE=service.events
DLX_EXCHANGE=ceo.commands.dlx
RABBITMQ_PREFETCH=20

# Cross-Service Portal Integration
CEO_DASHBOARD_API_URL=http://127.0.0.1:8005
ADMIN_PORTAL_API_URL=http://127.0.0.1:8002

# Gemini models (defaults shown). Gemini's free tier gives each model its own small daily allowance and Pro models
# none, so sentiment tries these in order and moves on when one's limit is used up; the result says which ran.
# SENTIMENT_MODELS=gemini-2.5-flash,gemini-3.8-flash,gemini-3.5-flash
# A stronger first choice for Shaun's and investor posts, e.g. gemini-3.1-pro-preview on a paid tier (unset: same chain)
# SENTIMENT_MODEL_HIGH_STAKES=
# Reading text in images uses light models with their own allowance:
# IMAGE_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
